<?xml version="1.0" encoding="utf-8"?>
<!--
  Kavach deliberately opts out of cloud backup. The policy database describes
  which apps the user distrusts; that is sensitive and must not leave the device.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
